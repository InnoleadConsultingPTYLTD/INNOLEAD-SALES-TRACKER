# Copy this to .env and fill in your values

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://innolead_user:yourpassword@localhost:5432/innolead_db

# JWT secret — generate a strong random string, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Token expiry in minutes (default 60 = 1 hour)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed origins for CORS (your React app's URL)
# Comma-separated for multiple, e.g.: http://localhost:3000,https://innolead.onrender.com
CORS_ORIGINS=http://localhost:3000
